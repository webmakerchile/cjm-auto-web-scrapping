run = "python3 cjm_precios_ps.py"
entrypoint = "cjm_precios_ps.py"
modules = ["python-3.12", "bash", "nix", "postgresql-16"]

[nix]
channel = "stable-25_05"
packages = ["geckodriver"]

[env]
PYTHONUNBUFFERED = "1"
PYTHONIOENCODING = "utf-8"

# El boton Run hace una corrida en seco. Nunca escribe en Shopify: para eso
# hacen falta DRY_RUN = False en el archivo y la bandera --aplicar.
[deployment]
run = ["gunicorn", "--bind=0.0.0.0:5000", "--workers=1", "--threads=8", "panel.app:app"]

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 8080
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 panel/app.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
